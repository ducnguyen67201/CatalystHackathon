{
  "name": "june-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/StartDevelopment.ts",
    "dev:api": "tsx watch src/server/StartApi.ts",
    "dev:web": "vite",
    "dev:worker": "tsx watch src/server/StartWorker.ts",
    "setup": "tsx scripts/SetupLocal.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/StartApi.js",
    "worker": "node dist/server/StartWorker.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/Integration.test.ts",
    "test:integration": "vitest run test/Integration.test.ts",
    "dev:doppler": "doppler run --forward-signals -- pnpm dev",
    "setup:doppler": "doppler run --forward-signals -- pnpm setup"
  },
  "dependencies": {
    "@elevenlabs/react": "1.18.0",
    "@elevenlabs/elevenlabs-js": "2.73.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@t3-oss/env-core": "^0.13.10",
    "@trigger.dev/sdk": "4.7.4",
    "cron-parser": "^5.4.0",
    "csv-parse": "7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.13.0",
    "prettier": "^3.7.4",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
