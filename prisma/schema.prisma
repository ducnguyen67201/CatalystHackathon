generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Workspace {
  id String @id
  revision Int @default(0)
  profile Json
  onboarding Json @default("{}")
  schedule Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots FinancialSnapshot[]
  evidence Evidence[]
  briefs Brief[]
  rehearsals Rehearsal[]
  milestones Milestone[]
  notices Notice[]
  jobs WorkflowJob[]
  investors TrackedInvestor[]
  scenarioGenerations ScenarioGeneration[]
}
model FinancialSnapshot {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  hash String
  payload Json
  createdAt DateTime @default(now())
  @@unique([workspaceId, hash])
  @@index([workspaceId, createdAt])
}
model Evidence {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  eventKey String
  payload Json
  createdAt DateTime @default(now())
  @@unique([workspaceId, eventKey])
  @@index([workspaceId, createdAt])
}
model Brief {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  payload Json
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model Rehearsal {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  conversationId String? @unique
  payload Json
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model Milestone {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  payload Json
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model Notice {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  payload Json
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model WorkflowJob {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  key String @unique
  kind String
  status String @default("queued")
  attempts Int @default(0)
  runAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  result String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scenarioGeneration ScenarioGeneration?
  @@index([status, runAt])
  @@index([workspaceId, createdAt])
}

model ScenarioGeneration {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  investorId String
  jobId String @unique
  job WorkflowJob @relation(fields: [jobId], references: [id])
  input Json
  output Json?
  inputHash String
  requestHash String
  promptVersion String
  model String
  mode String
  createdAt DateTime @default(now())
  @@index([workspaceId, investorId, createdAt])
}

model TrackedInvestor {
  id String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  key String
  payload Json
  createdAt DateTime @default(now())
  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt])
}
