DATABASE_URL=postgresql://june:june_local@127.0.0.1:55436/june
API_PORT=4318
WEB_ORIGIN=http://127.0.0.1:4317
# Structured terminal logs; debug includes per-source acceptance/rejection reasons.
LOG_LEVEL=debug
# Live research requires both credentials. Private financials are not sent to Exa.
EXA_API_KEY=
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-6.1-sol
# Post-call evaluation runs automatically using OPENAI_API_KEY.
# Selected company evidence and transcripts are sent to OpenAI.
EVALUATION_MODEL=gpt-6.1-sol
# Independent scenario generation. Live mode uses OPENAI_API_KEY; no Exa request.
SCENARIO_MODE=demo
SCENARIO_MODEL=gpt-6.1-sol
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Optional built-in LiveAvatar interviewer (FULL mode). No ElevenLabs connector required.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_CONTEXT_ID=
# Optional hosted workflow adapter. Local durable worker works without this.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Optional webhook-only local development tunnel (requires ngrok).
DEV_WEBHOOK_TUNNEL=false
DEV_WEBHOOK_PORT=4319
DEV_WEBHOOK_URL=
# Optional when ngrok is already authenticated locally.
NGROK_AUTHTOKEN=

# Optional founder email alerts; configure a verified Resend sender. Disabled until confirmed in UI.
RESEND_API_KEY=
NOTIFICATION_FROM=
